!% -D
!% -Cu
!% +language_name=Spanish
! Las lineas de arriba deben estar siempre primero:
! 	-D compila en modo debug, -Cu lee el fuente como UTF-8 (convencion de
! 	INFSP6 desde la 6.12, ver Libreria INFSP6), +language_name=Spanish
! 	carga INFSP6.
! Para la publicacion, puede eliminarse la linea -D (modo debug).

! =====================================================================
! Plantilla de juego minimo compilable en Inform6
!        Author: Morgul (adaptado para el pipeline de regtest de INFSP6)
! Serial Number: 806.1
!          Note: For use with Inform 6 + INFSP6 (lib-INFSP6-6.12).
!   Description: "Una plantilla basica de juego en I6."
!================================================================
! NOTA: el original de Morgul usaba las clases Habitacion/Objeto de
! Facilitar.h (no incluido en este repo). Esta version usa Object simple
! para no depender de ese archivo. Convertido de CP1252 a UTF-8 el
! 2026-09-14 para poder compilar con -Cu junto a la libreria (tambien UTF-8).

! CONSTANTES

Constant Story "Prueba Minima INFSP6";
Constant Headline "^Smoke test del pipeline de regtest de INFSP6^";
Release 1;

! Queremos usar el comando 'Salidas'
Constant ADMITIR_COMANDO_SALIDAS;
! No queremos usar los comandos 'Lugares' y 'Objetos'
Constant NO_PLACES;
! No queremos usar puntuacion
Constant NO_SCORE;


! INCLUDES

Include "Parser";
Include "Verblib";
Include "SpanishG";


! HABITACIONES

Object LOCALIZACION_INICIAL "Cuarto de pruebas"
  with
    description "Un cuarto vacio, usado para el smoke test del pipeline.",
  has
    light;


! OBJETOS

Object OBJETO_INICIAL "piedra"
  with
    name 'piedra',
    description "Una piedra comun y silvestre.",
  has
  ;


! RUTINAS

[ Initialise;
  lookmode = 2;
  location = LOCALIZACION_INICIAL;
  move OBJETO_INICIAL to player;
];
